{
  "name": "fomo-tracker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:init": "wrangler d1 execute fomo-tracker --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute fomo-tracker --remote --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute fomo-tracker --remote --file=./schema-migrate.sql"
  },
  "devDependencies": {
    "vitest": "^3.2.7",
    "wrangler": "^3.90.0"
  }
}
